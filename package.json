{
  "name": "ai-journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && svelte-check --tsconfig web/tsconfig.json",
    "test": "node --import tsx --test server/src/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.8",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22",
    "concurrently": "^10.0.6",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
